# 复制成 .env 后填写；`.env` 已被 .gitignore 忽略，不会入库。
# 用 Node 22+ 的 --env-file 载入：  node --env-file=.env serve.mjs

# ── 模型端点（可选；不配则世界走本地确定性替身，照常运行）──
# 多个端点用逗号分隔，按序退回
MODEL_PROVIDERS=
# 与 MODEL_PROVIDERS 按位对应的密钥
MODEL_KEYS=
# 模型 id；多供应商时用 MODEL_NAMES（逗号分隔，按位对应）
MODEL_NAME=
MODEL_NAMES=

# ── 大脑中继与独立测试入口 ──
# 不设 BRAIN_RELAY_TOKEN 时 /brain/* 整体 404；公开部署由平台密文/明文变量注入。
BRAIN_RELAY_TOKEN=
BRAIN_RELAY_TTL_MS=5400
# 独立 OpenAI 兼容测试入口默认关闭；生产镜像启用。令牌优先 MODEL_TEST_TOKEN，缺省复用上面。
MODEL_TEST_ENABLED=0
MODEL_TEST_TOKEN=
MODEL_TEST_MODEL=qwen3.8-27b
MODEL_TEST_MAX_TOKENS=512
MODEL_TEST_MAX_BYTES=16384
MODEL_TEST_MAX_INFLIGHT=2
MODEL_TEST_RATE_CAPACITY=2
MODEL_TEST_RATE_REFILL_MS=10000

# ── 运行姿态 ──
# local = 本地替身（默认，0 成本）；model = 接上面配置的真实模型
BRAIN=local
# game 只推进生存世界；research 保留实时 A/B
GAME_MODE=research
SURV_CATCHUP_CAP=120
# 正式游戏时间节奏：1 游戏分钟 = 多少真实毫秒。默认 6000 = 现实 1 分钟走 10 游戏分
# （1 天 1440 分 = 144 现实分钟）。正式连续世界的调度只认这个值。
GAME_MS_PER_MINUTE=6000
# 每拍间隔（毫秒），只服务研究态/非连续旧路径；正式世界不读它。
# 部署游戏态时可设 360000（=60 游戏分 × 6000ms），让仍按「刻」换算的表现层同口径。
TICK_MS=1200
# 每日模型调用额度（跨天归零）
MAX_CALLS=120
# 无人观看多久后停止调用真模型 —— 单位是毫秒！
PRESENCE_MS=180000

# ── 服务端 ──
PORT=7860
HOST=0.0.0.0
DATA_DIR=data

# ── 安全（公开部署必读 SECURITY.md）──
# 不设时破坏性 /ctl 要求服务端签发的会话 nonce（自选 cookie/header 无效；一次性 + 60s TTL）；
# 设了之后破坏性 /ctl 只认 Bearer / x-ctl-token。例外：MAIN 的 survival_reset 也认会话 nonce
# （一次性、60s、全局 3 次/分钟、写 [audit] main_reset），供浏览器“新开一局”。
CTL_TOKEN=
# 覆盖 MAIN reset 的频率（默认 3 次 / 60s）
MAIN_RESET_LIMIT=3
# HTTPS 部署建议设 1，让 cookie 带 Secure（也可由反代的 x-forwarded-proto=https 自动判断）
COOKIE_SECURE=0
# 不设时 /chat 转发整体关闭（404）
CHAT_TOKEN=

# ── 持久化 ──
# 每多少刻落一版主档（默认 10）；调小可缩短硬杀进程的不可恢复窗口，代价是写盘更频繁
SAVE_EVERY=10

# ── 世界级开关（不设＝默认行为）──
# 工坊每天收几次工；不设＝无上限
WORK_CAP=
# 单拍模型调用上限；0＝不设上限（默认）
MAX_CALLS_PER_TICK=0
