# 复制成 .env 后填写；`.env` 已被 .gitignore 忽略，不会入库。
# 用 Node 22+ 的 --env-file 载入：  node --env-file=.env serve.mjs

# ── 模型端点（可选；不配则世界走本地确定性替身，照常运行）──
# 多个端点用逗号分隔，按序退回
MODEL_PROVIDERS=
# 与 MODEL_PROVIDERS 按位对应的密钥
MODEL_KEYS=
# 模型 id；多供应商时用 MODEL_NAMES（逗号分隔，按位对应）
MODEL_NAME=
MODEL_NAMES=

# ── 运行姿态 ──
# local = 本地替身（默认，0 成本）；model = 接上面配置的真实模型
BRAIN=local
# game 只推进生存世界；research 保留实时 A/B
GAME_MODE=research
SURV_CATCHUP_CAP=120
# 每拍间隔（毫秒）
TICK_MS=1200
# 每日模型调用额度（跨天归零）
MAX_CALLS=120
# 无人观看多久后停止调用真模型 —— 单位是毫秒！
PRESENCE_MS=180000

# ── 服务端 ──
PORT=7860
HOST=0.0.0.0
DATA_DIR=data

# ── 安全（公开部署必读 SECURITY.md）──
# 不设时写路由只挡浏览器跨站请求；设了之后要求 Bearer / x-ctl-token
CTL_TOKEN=
# 不设时 /chat 转发整体关闭（404）
CHAT_TOKEN=

# ── 世界级开关（不设＝默认行为）──
# 工坊每天收几次工；不设＝无上限
WORK_CAP=
# 单拍模型调用上限；0＝不设上限（默认）
MAX_CALLS_PER_TICK=0
